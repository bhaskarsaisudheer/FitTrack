# --- Secrets -----------------------------------------------------------------
# The server's .env holds the real database password and must never be
# committed. Only .env.example, which has placeholder values, is tracked.
.env
.env.local
.env.*.local
!.env.example

# --- Dependencies ------------------------------------------------------------
node_modules
.pnp
.pnp.js

# --- Build output ------------------------------------------------------------
dist
dist-ssr
build
*.local

